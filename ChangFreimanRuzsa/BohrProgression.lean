/-! # A large progression inside a chord neighborhood

This file shows that the chord neighborhood $\{x : |1 - \psi(x)| \le \varepsilon\
\text{for all}\ \psi \in \Delta\}$ of a finite set $\Delta$ of characters of
$\mathbb{Z}/q\mathbb{Z}$, as in `ChangFreimanRuzsa.Fourier`, contains a proper progression of
comparable size.

Writing $\psi_j(x) = e(r_j x / q)$, the chord width is controlled by integer representatives of the
products $r_j x$, so the construction is carried out for the lattice
$$\mathtt{freqLattice}\ r = \{(x, a_1, \dots, a_k) \in \mathbb{Z}^{k+1} :
a_j \equiv r_j x \pmod q\}$$
inside the box `freqBox q D` of half-widths $(q, D, \dots, D)$.

- `exists_shortFamily_freqLattice`: Minkowski's second theorem for the lattice and the ellipsoid
  inscribed in the box gives $k + 1$ independent lattice vectors $v_0, \dots, v_k$ with $v_i$ in
  the $\lambda_i$-dilate of the box and $\prod_i \lambda_i \le q^{k-1} / D^k$ up to a dimensional
  factor.
- The progression is generated by the first coordinates of the $v_i$, with the coefficient of $v_i$
  ranging over $[-L_i, L_i]$ for $L_i = \lfloor 1 / (4 (k + 1) \lambda_i) \rfloor$. Every
  combination then lies in half the box. This puts the progression in the chord neighborhood, and
  it makes the progression proper because the first coordinate cannot wrap around modulo $q$.
- The size of the progression follows from the bound on $\prod_i \lambda_i$.

## Main results

* `exists_proper_gap_of_freqLattice`: the arithmetic formulation.
* `exists_proper_gap_chordSet`: the chord-width formulation.

The modulus $q$ need not be prime: the lattice has index $q^k$ in $\mathbb{Z}^{k+1}$ for every $q$.
-/

@[expose] public section

namespace ChangFreimanRuzsa

open scoped Pointwise

noncomputable section

section FrequencyLattice

variable {q k : ℕ}

/-- The homomorphism measuring the failure of an integer vector `(x, a₁, …, a_k)` to satisfy the
congruences `aⱼ ≡ rⱼ x (mod q)`. -/
def freqHom (r : Fin k → ZMod q) : (Fin (k + 1) → ℤ) →+ (Fin k → ZMod q) where
  toFun v j := ((v j.succ : ℤ) : ZMod q) - r j * ((v 0 : ℤ) : ZMod q)
  map_zero' := by
    funext j
    simp
  map_add' u v := by
    funext j
    simp only [Pi.add_apply]
    push_cast
    ring

/-- The lattice of integer vectors whose frequency coordinates represent the corresponding
multiples of the first coordinate. -/
def freqLattice (r : Fin k → ZMod q) : AddSubgroup (Fin (k + 1) → ℤ) := (freqHom r).ker

lemma mem_freqLattice {r : Fin k → ZMod q} {v : Fin (k + 1) → ℤ} :
    v ∈ freqLattice r ↔ ∀ j, ((v j.succ : ℤ) : ZMod q) = r j * ((v 0 : ℤ) : ZMod q) := by
  simp [freqLattice, AddMonoidHom.mem_ker, funext_iff, freqHom, sub_eq_zero]

/-- The box measuring the lattice: a whole period in the first coordinate and the allowed
frequency width in the others. -/
def freqBox (q D : ℕ) : Fin (k + 1) → ℕ := Fin.cases q fun _ ↦ D

@[simp] lemma freqBox_zero (q D : ℕ) : freqBox (k := k) q D 0 = q := rfl

@[simp] lemma freqBox_succ (q D : ℕ) (j : Fin k) : freqBox q D j.succ = D := rfl

/-- The matrix whose columns `(1, r₁, …, r_k), q e₁, …, q e_k` span the frequency lattice. -/
def freqMatrix (r : Fin k → ZMod q) : Matrix (Fin (k + 1)) (Fin (k + 1)) ℤ :=
  Matrix.of fun i j ↦ Fin.cases (motive := fun _ ↦ ℤ) (if j = 0 then 1 else 0)
    (fun i' ↦ if j = 0 then ((r i').val : ℤ) else if j = i'.succ then (q : ℤ) else 0) i

lemma freqMatrix_mulVec_zero (r : Fin k → ZMod q) (c : Fin (k + 1) → ℤ) :
    (freqMatrix r).mulVec c 0 = c 0 := by
  simp [freqMatrix, Matrix.mulVec, dotProduct]

lemma freqMatrix_mulVec_succ (r : Fin k → ZMod q) (c : Fin (k + 1) → ℤ) (j : Fin k) :
    (freqMatrix r).mulVec c j.succ = ((r j).val : ℤ) * c 0 + q * c j.succ := by
  simp [freqMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_succ, Fin.succ_ne_zero]

lemma freqMatrix_mulVec_mem [NeZero q] (r : Fin k → ZMod q) (c : Fin (k + 1) → ℤ) :
    (freqMatrix r).mulVec c ∈ freqLattice r := by
  rw [mem_freqLattice]
  intro j
  rw [freqMatrix_mulVec_zero, freqMatrix_mulVec_succ]
  simp

lemma det_freqMatrix (r : Fin k → ZMod q) : (freqMatrix r).det = (q : ℤ) ^ k := by
  rw [Matrix.det_of_isLowerTriangular, Fin.prod_univ_succ]
  · simp [freqMatrix]
  · intro i j hij
    have hj : j ≠ 0 := Fin.pos_iff_ne_zero.mp ((Fin.zero_le i).trans_lt hij)
    have hji : j ≠ i := fun h ↦ lt_irrefl _ (h ▸ hij)
    induction i using Fin.cases with
    | zero => simp [freqMatrix, hj]
    | succ i => simp [freqMatrix, hj, hji]

/-- The weights `(D ^ 2, q ^ 2, …, q ^ 2)` of the ellipsoid inscribed in the frequency box. -/
def freqWeight (q D : ℕ) : Fin (k + 1) → ℕ := Fin.cases (D ^ 2) fun _ ↦ q ^ 2

lemma freqWeight_pos {D : ℕ} (hq : 0 < q) (hD : 0 < D) : ∀ i, 0 < freqWeight (k := k) q D i :=
  Fin.cases (pow_pos hD 2) fun _ ↦ pow_pos hq 2

lemma freqWeight_mul_sq (q D : ℕ) (i : Fin (k + 1)) :
    freqWeight q D i * freqBox q D i ^ 2 = (q * D) ^ 2 := by
  induction i using Fin.cases with
  | zero => simp [freqWeight, freqBox, mul_pow, mul_comm]
  | succ i => simp [freqWeight, freqBox, mul_pow]

lemma prod_freqWeight (q D : ℕ) : ∏ i, freqWeight (k := k) q D i = D ^ 2 * (q ^ 2) ^ k := by
  simp [Fin.prod_univ_succ, freqWeight]

/-- The dilation of the frequency box that the ellipsoid norm of `v` certifies. -/
def freqDilation (q D : ℕ) (v : Fin (k + 1) → ℤ) : ℝ :=
  √(∑ j, (freqWeight q D j : ℝ) * (v j : ℝ) ^ 2) / (q * D)

lemma freqDilation_pos {D : ℕ} (hq : 0 < q) (hD : 0 < D) {v : Fin (k + 1) → ℤ} (hv : v ≠ 0) :
    0 < freqDilation q D v := by
  obtain ⟨j, hj⟩ := Function.ne_iff.mp hv
  refine div_pos (Real.sqrt_pos.mpr ((mul_pos
    (by exact_mod_cast freqWeight_pos hq hD j : (0 : ℝ) < freqWeight q D j)
    (sq_pos_of_ne_zero (Int.cast_ne_zero.mpr hj))).trans_le ?_)) (by positivity)
  refine Finset.single_le_sum (f := fun j ↦ (freqWeight q D j : ℝ) * (v j : ℝ) ^ 2) ?_
    (Finset.mem_univ j)
  intro i _
  positivity

lemma isShort_freqDilation {D : ℕ} (hq : 0 < q) (hD : 0 < D) (v : Fin (k + 1) → ℤ) :
    IsShort (freqBox q D) (freqDilation q D v) v := by
  intro j
  have hw : (freqWeight q D j : ℝ) * (freqBox q D j : ℝ) ^ 2 = ((q : ℝ) * D) ^ 2 := by
    exact_mod_cast freqWeight_mul_sq q D j
  have hle : ((v j : ℝ) * (q * D)) ^ 2 ≤
      (∑ j, (freqWeight q D j : ℝ) * (v j : ℝ) ^ 2) * (freqBox q D j : ℝ) ^ 2 := by
    rw [mul_pow, ← hw, ← mul_assoc, mul_comm ((v j : ℝ) ^ 2)]
    refine mul_le_mul_of_nonneg_right ?_ (sq_nonneg _)
    refine Finset.single_le_sum (f := fun j ↦ (freqWeight q D j : ℝ) * (v j : ℝ) ^ 2) ?_
      (Finset.mem_univ j)
    intro i _
    positivity
  have hpos : (0 : ℝ) < q * D := by positivity
  rw [freqDilation, div_mul_eq_mul_div, le_div_iff₀ hpos]
  calc |(v j : ℝ)| * (q * D) = |(v j : ℝ) * (q * D)| := by rw [abs_mul, abs_of_pos hpos]
    _ ≤ √((∑ j, (freqWeight q D j : ℝ) * (v j : ℝ) ^ 2) * (freqBox q D j : ℝ) ^ 2) :=
        Real.abs_le_sqrt hle
    _ = _ := by rw [Real.sqrt_mul' _ (sq_nonneg _), Real.sqrt_sq (Nat.cast_nonneg _)]

/-- The dimensional factor of Minkowski's second theorem is absorbed by `4 ^ ((k + 3) (k + 1))`. -/
lemma two_pow_mul_factorial_le (k : ℕ) :
    2 ^ (k + 1) * (k + 1).factorial * (2 ^ k) ^ 2 ≤ (2 ^ ((k + 3) * (k + 1))) ^ 2 := by
  have hfact : (k + 1).factorial ≤ 2 ^ ((k + 1) * (k + 1)) :=
    (Nat.factorial_le_pow _).trans <| (pow_mul 2 (k + 1) (k + 1)).symm ▸
      Nat.pow_le_pow_left Nat.lt_two_pow_self.le _
  calc 2 ^ (k + 1) * (k + 1).factorial * (2 ^ k) ^ 2
      ≤ 2 ^ (k + 1) * 2 ^ ((k + 1) * (k + 1)) * (2 ^ k) ^ 2 := by gcongr
    _ = 2 ^ (k + 1 + (k + 1) * (k + 1) + k * 2) := by ring
    _ ≤ 2 ^ ((k + 3) * (k + 1) * 2) := Nat.pow_le_pow_right two_pos (by nlinarith)
    _ = _ := pow_mul _ _ _

/-- The bound of Minkowski's second theorem for the frequency lattice, in terms of dilations. -/
lemma prod_sqrt_div_le {D : ℕ} (hq : 0 < q) (hD : 0 < D) {N : Fin (k + 1) → ℝ}
    (hN : ∀ i, 0 ≤ N i)
    (h : ∏ i, N i ≤ 2 ^ (k + 1) * (k + 1).factorial * (((q : ℝ) ^ k) ^ 2 * (D ^ 2 * (q ^ 2) ^ k))) :
    (q : ℝ) * ((D : ℝ) + 1) ^ k * ∏ i, √(N i) / (q * D) ≤
      2 ^ ((k + 3) * (k + 1)) * (q : ℝ) ^ k := by
  have hNprod : 0 ≤ ∏ i, N i := Finset.prod_nonneg fun i _ ↦ hN i
  have hD1 : ((D : ℝ) + 1) ^ k ≤ 2 ^ k * (D : ℝ) ^ k := by
    rw [← mul_pow]
    exact pow_le_pow_left₀ (by positivity) (by linarith [(Nat.one_le_cast (α := ℝ)).mpr hD]) k
  have hnum : (2 : ℝ) ^ (k + 1) * (k + 1).factorial * (2 ^ k) ^ 2 ≤
      (2 ^ ((k + 3) * (k + 1))) ^ 2 := by
    exact_mod_cast two_pow_mul_factorial_le k
  refine (sq_le_sq₀ (mul_nonneg (by positivity) (Finset.prod_nonneg fun i _ ↦ by positivity))
    (by positivity)).mp ?_
  simp_rw [mul_pow _ (∏ i, √(N i) / ((q : ℝ) * D)), ← Finset.prod_pow, div_pow,
    Real.sq_sqrt (hN _)]
  rw [Finset.prod_div_distrib, Finset.prod_const, Finset.card_univ, Fintype.card_fin,
    ← mul_div_assoc, div_le_iff₀ (by positivity)]
  calc ((q : ℝ) * ((D : ℝ) + 1) ^ k) ^ 2 * ∏ i, N i
      ≤ ((q : ℝ) * (2 ^ k * (D : ℝ) ^ k)) ^ 2 * (2 ^ (k + 1) * (k + 1).factorial *
          (((q : ℝ) ^ k) ^ 2 * (D ^ 2 * (q ^ 2) ^ k))) := by gcongr
    _ = 2 ^ (k + 1) * (k + 1).factorial * (2 ^ k) ^ 2 *
          ((q : ℝ) ^ (4 * k + 2) * (D : ℝ) ^ (2 * k + 2)) := by ring
    _ ≤ (2 ^ ((k + 3) * (k + 1))) ^ 2 * ((q : ℝ) ^ (4 * k + 2) * (D : ℝ) ^ (2 * k + 2)) := by
        gcongr
    _ = _ := by ring

/-- Minkowski's second theorem for the frequency lattice: there are $k + 1$ independent lattice
vectors $v_i$, each in the $\lambda_i$-dilate of the box, with
$q (D + 1)^k \prod_i \lambda_i \le 2^{(k + 3)(k + 1)} q^k$. -/
lemma exists_shortFamily_freqLattice [NeZero q] (r : Fin k → ZMod q) {D : ℕ} (hq : 0 < q)
    (hD : 0 < D) :
    ∃ (v : Fin (k + 1) → Fin (k + 1) → ℤ) (lam : Fin (k + 1) → ℝ), LinearIndependent ℤ v ∧
      (∀ i, 0 < lam i) ∧ (∀ i, v i ∈ freqLattice r ∧ IsShort (freqBox q D) (lam i) (v i)) ∧
      (q : ℝ) * ((D : ℝ) + 1) ^ k * ∏ i, lam i ≤ 2 ^ ((k + 3) * (k + 1)) * (q : ℝ) ^ k := by
  obtain ⟨v, hv, hmem, hprod⟩ := exists_linearIndependent_prod_weightedNorm_le (freqMatrix r)
    (by simp [det_freqMatrix, NeZero.ne q]) (freqWeight q D) (freqWeight_pos hq hD)
  refine ⟨v, fun i ↦ freqDilation q D (v i), hv, fun i ↦ freqDilation_pos hq hD (hv.ne_zero i),
    ?_, ?_⟩
  · intro i
    obtain ⟨c, hc⟩ := hmem i
    exact ⟨hc ▸ freqMatrix_mulVec_mem r c, isShort_freqDilation hq hD (v i)⟩
  · refine prod_sqrt_div_le hq hD (fun i ↦ Finset.sum_nonneg fun j _ ↦ by positivity) ?_
    have hw : ∏ j, (freqWeight (k := k) q D j : ℤ) = (D : ℤ) ^ 2 * ((q : ℤ) ^ 2) ^ k := by
      exact_mod_cast prod_freqWeight (k := k) q D
    rw [det_freqMatrix, hw] at hprod
    exact_mod_cast hprod

end FrequencyLattice

/-- A combination of an adapted family whose coefficients are small against the successive minima
stays inside the correspondingly shrunken box. -/
lemma abs_sum_zsmul_le {d : ℕ} {L : Fin d → ℕ} {lam : Fin d → ℝ} {v : Fin d → (Fin d → ℤ)}
    (hv : ∀ i, IsShort L (lam i) (v i)) {n : Fin d → ℤ} {c : ℝ}
    (hn : ∑ i, |(n i : ℝ)| * lam i ≤ c) (j : Fin d) :
    |(((∑ i, n i • v i) j : ℤ) : ℝ)| ≤ c * L j := by
  rw [(by simp [Finset.sum_apply] : ((∑ i, n i • v i) j : ℤ) = ∑ i, n i * v i j), Int.cast_sum]
  apply (Finset.abs_sum_le_sum_abs _ _).trans
  refine (Finset.sum_le_sum (g := fun i ↦ |(n i : ℝ)| * lam i * L j) ?_).trans ?_
  · intro i _
    rw [Int.cast_mul, abs_mul]
    exact (mul_le_mul_of_nonneg_left (hv i j) (abs_nonneg _)).trans_eq (by ring)
  · rw [← Finset.sum_mul]
    exact mul_le_mul_of_nonneg_right hn (Nat.cast_nonneg _)

/-- A real number $z$ is at most $2 \lfloor z \rfloor + 1$, so the symmetric range
$[-\lfloor z \rfloor, \lfloor z \rfloor]$ has at least $z$ elements, also when $z < 1$. -/
lemma le_two_mul_floor_add_one (z : ℝ) : z ≤ 2 * (⌊z⌋₊ : ℝ) + 1 := by
  rcases le_or_gt z 1 with hle | hlt
  · linarith [Nat.cast_nonneg (α := ℝ) ⌊z⌋₊]
  · linarith [Nat.lt_floor_add_one z]

/-- If $q \mid z$ and $2 |z| \le m \le q$, then $z = 0$. -/
lemma eq_zero_of_dvd_of_two_mul_abs_le {q z m : ℤ} (hq : 0 < q) (hdvd : q ∣ z)
    (hm : 2 * |z| ≤ m) (hmq : m ≤ q) : z = 0 := by
  obtain ⟨c, rfl⟩ := hdvd
  rcases eq_or_ne c 0 with rfl | hc
  · ring
  · rw [abs_mul, abs_of_pos hq] at hm
    nlinarith [Int.one_le_abs hc]

/-- The elements of a progression built with a symmetric coefficient range are the combinations of
its steps with integer coefficients in that range. -/
lemma gapMap_neg_stepsHom_eq {G : Type*} [AddCommGroup G] {d : ℕ} (x : Fin d → G)
    (L len : Fin d → ℕ) (w : (i : Fin d) → Fin (len i)) {n : Fin d → ℤ}
    (hn : ∀ i, n i = ((w i : ℕ) : ℤ) - L i) :
    gapMap (stepsHom x fun i ↦ -(L i : ℤ)) x len w = stepsHom x n := by
  rw [gapMap, stepsHom_apply, stepsHom_apply, ← Finset.sum_add_distrib]
  congr with i
  rw [hn i, sub_zsmul, natCast_zsmul, neg_zsmul]
  abel

/-! ## Symmetric progressions

Progressions whose $i$-th coefficient ranges over $[-L_i, L_i]$. -/

section SymmetricGAP

/-- The progression with steps `x` whose `i`-th coefficient ranges over `[-Lᵢ, Lᵢ]`. -/
def symmetricGAP {G : Type*} [DecidableEq G] [AddCommGroup G] {d : ℕ} (x : Fin d → G)
    (L : Fin d → ℕ) : GAP G :=
  GAP.ofData d (stepsHom x fun i ↦ -(L i : ℤ)) x (fun i ↦ 2 * L i + 1) fun _ ↦ Nat.succ_pos _

variable {G : Type*} [DecidableEq G] [AddCommGroup G] {d : ℕ} {x : Fin d → G} {L : Fin d → ℕ}

@[simp] lemma symmetricGAP_dim : (symmetricGAP x L).dim = d := rfl

@[simp] lemma symmetricGAP_length : (symmetricGAP x L).length = fun i ↦ 2 * L i + 1 := rfl

/-- Every element of the symmetric progression is a combination of its steps with coefficients in
`[-Lᵢ, Lᵢ]`. -/
lemma exists_coeff_of_mem_symmetricGAP {y : G} (hy : y ∈ (symmetricGAP x L).carrier) :
    ∃ n : Fin d → ℤ, (∀ i, |n i| ≤ (L i : ℤ)) ∧ y = stepsHom x n := by
  rw [(symmetricGAP x L).carrier_eq] at hy
  obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hy
  refine ⟨fun i : Fin d ↦ ((w i : ℕ) : ℤ) - L i, ?_,
    gapMap_neg_stepsHom_eq x L _ w fun _ ↦ rfl⟩
  intro i
  rw [abs_le]
  grind [(by simpa using (w i).isLt : (w i : ℕ) < 2 * L i + 1)]

/-- The symmetric progression is proper as soon as its steps admit no nonzero relation with
coefficients in the doubled range. -/
lemma proper_symmetricGAP
    (h : ∀ n : Fin d → ℤ, (∀ i, |n i| ≤ 2 * (L i : ℤ)) → stepsHom x n = 0 → ∀ i, n i = 0) :
    (symmetricGAP x L).Proper := by
  intro w w' hww'
  have hrel : stepsHom x ((fun i : Fin d ↦ ((w i : ℕ) : ℤ) - L i) -
      fun i : Fin d ↦ ((w' i : ℕ) : ℤ) - L i) = 0 := by
    rw [map_sub, sub_eq_zero]
    exact (gapMap_neg_stepsHom_eq x L _ w fun _ ↦ rfl).symm.trans
      (hww'.trans (gapMap_neg_stepsHom_eq x L _ w' fun _ ↦ rfl))
  have hbound : ∀ i : Fin d, |((fun i : Fin d ↦ ((w i : ℕ) : ℤ) - L i) -
      fun i : Fin d ↦ ((w' i : ℕ) : ℤ) - L i) i| ≤ 2 * (L i : ℤ) := by
    intro i
    simp only [Pi.sub_apply]
    rw [abs_le]
    grind [(by simpa using (w i).isLt : (w i : ℕ) < 2 * L i + 1),
      (by simpa using (w' i).isLt : (w' i : ℕ) < 2 * L i + 1)]
  funext i
  exact Fin.ext (by grind [h _ hbound hrel i, Pi.sub_apply])

end SymmetricGAP

/-! ## The progression -/

/-- For frequencies $r_1, \dots, r_k$ of $\mathbb{Z}/q\mathbb{Z}$ and a width $0 < D \le q$,
there is a proper progression of dimension $k + 1$ all of whose elements $y$ satisfy
$r_j y \equiv a_j \pmod q$ for integers $|a_j| \le D$, and whose size is at least
$q ((D + 1) / q)^k$ up to the factor $(2^{k + 5} (k + 1))^{k + 1}$. -/
lemma exists_proper_gap_of_freqLattice {q k : ℕ} [NeZero q] (r : Fin k → ZMod q) {D : ℕ}
    (hD : 0 < D) (hDq : D ≤ q) :
    ∃ Q : GAP (ZMod q), Q.Proper ∧ Q.dim = k + 1 ∧
      (∀ y ∈ Q.carrier, ∀ j, ∃ a : ℤ, (a : ZMod q) = r j * y ∧ |a| ≤ (D : ℤ)) ∧
      (q : ℝ) * ((D : ℝ) + 1) ^ k ≤
        (2 : ℝ) ^ ((k + 5) * (k + 1)) * ((k : ℝ) + 1) ^ (k + 1) * (q : ℝ) ^ k *
          Q.carrier.card := by
  have hq : 0 < q := Nat.pos_of_ne_zero (NeZero.ne q)
  obtain ⟨v, lam, hvindep, hlampos, hv, hlam⟩ := exists_shortFamily_freqLattice r hq hD
  obtain ⟨hvL, hvS⟩ := forall_and.mp hv
  set L : Fin (k + 1) → ℕ := fun i ↦ ⌊1 / (4 * ((k : ℝ) + 1) * lam i)⌋₊ with hLdef
  set len : Fin (k + 1) → ℕ := fun i ↦ 2 * L i + 1 with hlendef
  have hhalf : ∀ n : Fin (k + 1) → ℤ, (∀ i, |n i| ≤ 2 * L i) →
      (∑ i, n i • v i) ∈ freqLattice r ∧
        ∀ j, 2 * |(∑ i, n i • v i) j| ≤ (freqBox q D j : ℤ) := by
    intro n hn
    constructor
    · apply AddSubgroup.sum_mem
      intro i _
      exact AddSubgroup.zsmul_mem _ (hvL i) _
    · intro j
      have hsum : ∑ i, |(n i : ℝ)| * lam i ≤ 1 / 2 := by
        refine (Finset.sum_le_sum
          (g := fun _ : Fin (k + 1) ↦ 1 / (2 * ((k : ℝ) + 1))) ?_).trans ?_
        · intro i _
          have hlami := hlampos i
          have hni : |(n i : ℝ)| ≤ 2 * L i := by exact_mod_cast hn i
          have hfloor : (L i : ℝ) ≤ 1 / (4 * ((k : ℝ) + 1) * lam i) :=
            Nat.floor_le (by positivity)
          rw [le_div_iff₀ (by positivity)] at hfloor
          rw [le_div_iff₀ (by positivity)]
          nlinarith [mul_le_mul_of_nonneg_right hni
            (by positivity : (0 : ℝ) ≤ lam i * (2 * ((k : ℝ) + 1)))]
        · rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, mul_one_div,
            div_le_div_iff₀ (by positivity) (by norm_num)]
          push_cast
          ring_nf
          linarith
      rw [← Int.cast_le (R := ℝ)]
      push_cast
      linarith [abs_sum_zsmul_le hvS hsum j]
  set x : Fin (k + 1) → ZMod q := fun i ↦ ((v i 0 : ℤ) : ZMod q) with hxdef
  have hstepsHom : ∀ n : Fin (k + 1) → ℤ,
      stepsHom x n = (((∑ i, n i • v i) 0 : ℤ) : ZMod q) := by
    intro n
    rw [stepsHom_apply,
      (by simp [Finset.sum_apply] : ((∑ i, n i • v i) 0 : ℤ) = ∑ i, n i * v i 0), Int.cast_sum]
    congr with i
    rw [Int.cast_mul, zsmul_eq_mul, hxdef]
  have hqz : (0 : ℤ) < q := by exact_mod_cast hq
  have hrelation : ∀ n : Fin (k + 1) → ℤ, (∀ i, |n i| ≤ 2 * (L i : ℤ)) →
      stepsHom x n = 0 → ∀ i, n i = 0 := by
    intro n hn hzero i
    obtain ⟨hmem, hbox⟩ := hhalf n hn
    have hfirst : (∑ i, n i • v i) 0 = 0 := by
      refine eq_zero_of_dvd_of_two_mul_abs_le hqz ?_ (hbox 0) (by simp)
      rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, ← hstepsHom, hzero]
    refine Fintype.linearIndependent_iff.mp hvindep n ?_ i
    funext j
    refine Fin.cases hfirst ?_ j
    intro j
    refine eq_zero_of_dvd_of_two_mul_abs_le hqz ?_ (hbox j.succ) ?_
    · rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, mem_freqLattice.mp hmem j, hfirst]
      simp
    · rw [freqBox_succ]
      exact_mod_cast hDq
  refine ⟨symmetricGAP x L, proper_symmetricGAP hrelation, rfl, ?_, ?_⟩
  · intro y hy j
    obtain ⟨n, hn, rfl⟩ := exists_coeff_of_mem_symmetricGAP hy
    obtain ⟨hmem, hbox⟩ := hhalf n fun i ↦ (hn i).trans (by grind)
    refine ⟨(∑ i, n i • v i) j.succ, ?_, ?_⟩
    · rw [mem_freqLattice.mp hmem j, ← hstepsHom]
    · grind [hbox j.succ, freqBox_succ]
  · have hlen : ∀ i ∈ Finset.univ, 1 ≤ (len i : ℝ) * (4 * ((k : ℝ) + 1) * lam i) := by
      intro i _
      have hlami := hlampos i
      rw [← div_le_iff₀ (by positivity), hlendef, hLdef]
      push_cast
      exact le_two_mul_floor_add_one _
    have hone := Finset.one_le_prod₀ hlen
    rw [Finset.prod_mul_distrib, Finset.prod_mul_distrib, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin] at hone
    have hcard : ((symmetricGAP x L).carrier.card : ℝ) = ∏ i, (len i : ℝ) := by
      rw [GAP.card_eq_prod_length _ (proper_symmetricGAP hrelation), Nat.cast_prod]
      rfl
    rw [hcard]
    calc (q : ℝ) * ((D : ℝ) + 1) ^ k
        ≤ (q : ℝ) * ((D : ℝ) + 1) ^ k *
            ((∏ i, (len i : ℝ)) * ((4 * ((k : ℝ) + 1)) ^ (k + 1) * ∏ i, lam i)) :=
          le_mul_of_one_le_right (by positivity) hone
      _ = (q : ℝ) * ((D : ℝ) + 1) ^ k * (∏ i, lam i) *
            ((4 * ((k : ℝ) + 1)) ^ (k + 1) * ∏ i, (len i : ℝ)) := by ring
      _ ≤ 2 ^ ((k + 3) * (k + 1)) * (q : ℝ) ^ k *
            ((4 * ((k : ℝ) + 1)) ^ (k + 1) * ∏ i, (len i : ℝ)) :=
          mul_le_mul_of_nonneg_right hlam (by positivity)
      _ = _ := by
          rw [mul_pow, (by norm_num : (4 : ℝ) = 2 ^ 2), ← pow_mul]
          ring

/-- The chord neighborhood of width $\varepsilon$ of a finite set $\Delta$ of characters of
$\mathbb{Z}/q\mathbb{Z}$ contains a proper progression of dimension $|\Delta| + 1$ and density at
least $(\varepsilon / 2\pi)^{|\Delta|}$, up to the factor
$(2^{|\Delta| + 5} (|\Delta| + 1))^{|\Delta| + 1}$.

The hypothesis $2\pi \le \varepsilon q$ makes the neighborhood wider than one step of
$\mathbb{Z}/q\mathbb{Z}$. Without it the neighborhood can be $\{0\}$. -/
lemma exists_proper_gap_chordSet {q : ℕ} [NeZero q] (Δ : Finset (AddChar (ZMod q) ℂ)) {ε : ℝ}
    (hεq : 2 * Real.pi ≤ ε * q) (hε : ε ≤ 1) :
    ∃ Q : GAP (ZMod q), Q.Proper ∧ Q.dim = Δ.card + 1 ∧
      (Q.carrier : Set (ZMod q)) ⊆ {x | ∀ ψ ∈ Δ, ‖1 - ψ x‖ ≤ ε} ∧
      (q : ℝ) * (ε / (2 * Real.pi)) ^ Δ.card ≤
        (2 : ℝ) ^ ((Δ.card + 5) * (Δ.card + 1)) * ((Δ.card : ℝ) + 1) ^ (Δ.card + 1) *
          Q.carrier.card := by
  have hq : (0 : ℝ) < q := by exact_mod_cast Nat.pos_of_ne_zero (NeZero.ne q)
  have hpi := Real.pi_gt_three
  have hεpos : 0 < ε := by nlinarith
  choose r hr using fun i : Fin Δ.card ↦
    exists_frequency_chord_le ((Δ.equivFin.symm i : Δ) : AddChar (ZMod q) ℂ)
  have hfloor : (⌊ε * q / (2 * Real.pi)⌋₊ : ℝ) ≤ ε * q / (2 * Real.pi) :=
    Nat.floor_le (by positivity)
  have hDpos : 0 < ⌊ε * q / (2 * Real.pi)⌋₊ := by
    rw [Nat.floor_pos, le_div_iff₀ (by positivity)]
    linarith
  have hDq : ⌊ε * q / (2 * Real.pi)⌋₊ ≤ q := by
    refine (Nat.floor_le_floor (b := (q : ℝ)) ?_).trans (le_of_eq (Nat.floor_natCast (R := ℝ) q))
    rw [div_le_iff₀ (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_right hε hq.le]
  obtain ⟨Q, hproper, hdim, hcert, hsize⟩ :=
    exists_proper_gap_of_freqLattice r hDpos hDq
  refine ⟨Q, hproper, hdim, ?_, ?_⟩
  · intro y hy ψ hψ
    obtain ⟨a, ha, habs⟩ := hcert y hy (Δ.equivFin ⟨ψ, hψ⟩)
    have hchord := hr (Δ.equivFin ⟨ψ, hψ⟩) y a ha
    simp only [Equiv.symm_apply_apply] at hchord
    apply hchord.trans
    rw [div_le_iff₀ hq]
    have hcast : |(a : ℝ)| ≤ (⌊ε * q / (2 * Real.pi)⌋₊ : ℝ) := by exact_mod_cast habs
    rw [le_div_iff₀ (by positivity)] at hfloor
    nlinarith [abs_nonneg (a : ℝ)]
  · refine le_of_mul_le_mul_right ?_ (pow_pos hq Δ.card)
    have hgrow : (q : ℝ) * ((ε / (2 * Real.pi)) ^ Δ.card * (q : ℝ) ^ Δ.card) ≤
        (q : ℝ) * ((⌊ε * q / (2 * Real.pi)⌋₊ : ℝ) + 1) ^ Δ.card := by
      rw [← mul_pow]
      refine mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (by positivity) ?_ _) hq.le
      rw [div_mul_eq_mul_div]
      exact (Nat.lt_floor_add_one _).le
    linarith [hgrow.trans hsize]

end

