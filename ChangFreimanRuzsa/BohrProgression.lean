/-! # A large progression inside a Bohr set

This file shows that the Bohr set $\{x : |1 - \psi(x)| \le \varepsilon\
\text{for all}\ \psi \in \Delta\}$ of a finite set $\Delta$ of characters of
$\mathbb{Z}/q\mathbb{Z}$, as in `ChangFreimanRuzsa.Fourier`, contains a proper progression of
comparable size.

Writing $\psi_j(x) = e(r_j x / q)$, the chord width is controlled by integer representatives of the
products $r_j x$, so the construction is carried out for the lattice
$$\mathtt{freqLattice}\ r = \{(x, a_1, \dots, a_k) \in \mathbb{Z}^{k+1} :
a_j \equiv r_j x \pmod q\}$$
inside the box `freqBox q D` of half-widths $(q, D, \dots, D)$.

- `exists_linearIndependent_isShort_freqLattice`: Minkowski's second theorem for the lattice and
  the ellipsoid inscribed in the box gives $k + 1$ independent lattice vectors $v_0, \dots, v_k$
  with $v_i$ in the $t_i$-dilate of the box and $\prod_i t_i \le q^{k-1} / D^k$ up to a
  dimensional factor.
- The progression `freqGAP q v t` is generated by the first coordinates of the $v_i$, with the
  coefficient of $v_i$ ranging over $[-L_i, L_i]$ for $L_i = \lfloor 1 / (4 (k + 1) t_i) \rfloor$.
  Every combination with coefficients in $[-2 L_i, 2 L_i]$ lies in half the box
  (`two_mul_abs_sum_zsmul_le`). This puts the progression in the Bohr set
  (`exists_intCast_eq_mul_of_mem_freqGAP`), and it makes the progression proper because the first
  coordinate cannot wrap around modulo $q$ (`proper_freqGAP`).
- The size of the progression follows from the bound on $\prod_i t_i$
  (`one_le_prod_coeffBound_mul`).

## Main results

* `exists_proper_gap_forall_exists_intCast_eq_mul`: the arithmetic formulation.
* `exists_proper_gap_chordSet`: the chord-width formulation.

The modulus $q$ need not be prime: the lattice has index $q^k$ in $\mathbb{Z}^{k+1}$ for every $q$.
-/

@[expose] public section

namespace ChangFreimanRuzsa

open scoped Pointwise Nat

noncomputable section

section FrequencyLattice

variable {q k : ℕ}

/-- The homomorphism measuring the failure of an integer vector $(x, a_1, \dots, a_k)$ to satisfy
the congruences $a_j \equiv r_j x \pmod q$. -/
def freqHom (r : Fin k → ZMod q) : (Fin (k + 1) → ℤ) →+ (Fin k → ZMod q) where
  toFun v j := ((v j.succ : ℤ) : ZMod q) - r j * ((v 0 : ℤ) : ZMod q)
  map_zero' := by
    funext j
    simp
  map_add' u v := by
    funext j
    simp only [Pi.add_apply]
    push_cast
    ring

/-- The lattice of integer vectors whose frequency coordinates represent the corresponding
multiples of the first coordinate. -/
def freqLattice (r : Fin k → ZMod q) : AddSubgroup (Fin (k + 1) → ℤ) := (freqHom r).ker

lemma mem_freqLattice {r : Fin k → ZMod q} {v : Fin (k + 1) → ℤ} :
    v ∈ freqLattice r ↔ ∀ j, ((v j.succ : ℤ) : ZMod q) = r j * ((v 0 : ℤ) : ZMod q) := by
  simp [freqLattice, AddMonoidHom.mem_ker, funext_iff, freqHom, sub_eq_zero]

/-- The box measuring the lattice: a whole period in the first coordinate and the allowed
frequency width in the others. -/
def freqBox (q D : ℕ) : Fin (k + 1) → ℕ := Fin.cases q fun _ ↦ D

@[simp] lemma freqBox_zero (q D : ℕ) : freqBox (k := k) q D 0 = q := rfl

@[simp] lemma freqBox_succ (q D : ℕ) (j : Fin k) : freqBox q D j.succ = D := rfl

/-- The matrix whose columns $(1, r_1, \dots, r_k), q e_1, \dots, q e_k$ span the frequency
lattice. -/
def freqMatrix (r : Fin k → ZMod q) : Matrix (Fin (k + 1)) (Fin (k + 1)) ℤ :=
  Matrix.of fun i j ↦ Fin.cases (motive := fun _ ↦ ℤ) (if j = 0 then 1 else 0)
    (fun i' ↦ if j = 0 then ((r i').val : ℤ) else if j = i'.succ then (q : ℤ) else 0) i

lemma freqMatrix_mulVec_zero (r : Fin k → ZMod q) (c : Fin (k + 1) → ℤ) :
    (freqMatrix r).mulVec c 0 = c 0 := by
  simp [freqMatrix, Matrix.mulVec, dotProduct]

lemma freqMatrix_mulVec_succ (r : Fin k → ZMod q) (c : Fin (k + 1) → ℤ) (j : Fin k) :
    (freqMatrix r).mulVec c j.succ = ((r j).val : ℤ) * c 0 + q * c j.succ := by
  simp [freqMatrix, Matrix.mulVec, dotProduct, Fin.sum_univ_succ, Fin.succ_ne_zero]

lemma freqMatrix_mulVec_mem [NeZero q] (r : Fin k → ZMod q) (c : Fin (k + 1) → ℤ) :
    (freqMatrix r).mulVec c ∈ freqLattice r := by
  rw [mem_freqLattice]
  intro j
  rw [freqMatrix_mulVec_zero, freqMatrix_mulVec_succ]
  simp

lemma det_freqMatrix (r : Fin k → ZMod q) : (freqMatrix r).det = (q : ℤ) ^ k := by
  rw [Matrix.det_of_isLowerTriangular, Fin.prod_univ_succ]
  · simp [freqMatrix]
  · intro i j hij
    have hj : j ≠ 0 := Fin.pos_iff_ne_zero.mp ((Fin.zero_le i).trans_lt hij)
    have hji : j ≠ i := fun h ↦ lt_irrefl _ (h ▸ hij)
    induction i using Fin.cases with
    | zero => simp [freqMatrix, hj]
    | succ i => simp [freqMatrix, hj, hji]

/-- The weights $(D^2, q^2, \dots, q^2)$ of the ellipsoid inscribed in the frequency box. -/
def freqWeight (q D : ℕ) : Fin (k + 1) → ℕ := Fin.cases (D ^ 2) fun _ ↦ q ^ 2

lemma freqWeight_pos {D : ℕ} (hq : 0 < q) (hD : 0 < D) (i : Fin (k + 1)) :
    0 < freqWeight q D i :=
  Fin.cases (pow_pos hD 2) (fun _ ↦ pow_pos hq 2) i

lemma freqWeight_mul_sq (q D : ℕ) (i : Fin (k + 1)) :
    freqWeight q D i * freqBox q D i ^ 2 = (q * D) ^ 2 := by
  induction i using Fin.cases with
  | zero => simp [freqWeight, freqBox, mul_pow, mul_comm]
  | succ i => simp [freqWeight, freqBox, mul_pow]

lemma prod_freqWeight (q D : ℕ) : ∏ i, freqWeight (k := k) q D i = D ^ 2 * (q ^ 2) ^ k := by
  simp [Fin.prod_univ_succ, freqWeight]

/-- The dilation $\sqrt{\sum_j w_j v_j^2} / (q D)$ of the frequency box that the ellipsoid norm of
$v$ certifies. -/
def freqDilation (q D : ℕ) (v : Fin (k + 1) → ℤ) : ℝ :=
  √(∑ j, (freqWeight q D j : ℝ) * (v j : ℝ) ^ 2) / (q * D)

lemma freqDilation_pos {D : ℕ} (hq : 0 < q) (hD : 0 < D) {v : Fin (k + 1) → ℤ} (hv : v ≠ 0) :
    0 < freqDilation q D v := by
  obtain ⟨j, hj⟩ := Function.ne_iff.mp hv
  refine div_pos (Real.sqrt_pos.mpr ?_) (by positivity)
  refine Finset.sum_pos' (fun i _ ↦ by positivity) ⟨j, Finset.mem_univ j, ?_⟩
  exact mul_pos (by exact_mod_cast freqWeight_pos hq hD j)
    (sq_pos_of_ne_zero (by exact_mod_cast hj))

lemma isShort_freqDilation {D : ℕ} (hq : 0 < q) (hD : 0 < D) (v : Fin (k + 1) → ℤ) :
    IsShort (freqBox q D) (freqDilation q D v) v := by
  intro j
  have hqD : (0 : ℝ) < q * D := by positivity
  rw [freqDilation, div_mul_eq_mul_div, le_div_iff₀ hqD, ← abs_of_pos hqD, ← abs_mul,
    ← Real.sqrt_sq (Nat.cast_nonneg (freqBox q D j)), ← Real.sqrt_mul' _ (sq_nonneg _)]
  apply Real.abs_le_sqrt
  rw [mul_pow, ← (by exact_mod_cast freqWeight_mul_sq q D j :
      (freqWeight q D j : ℝ) * (freqBox q D j : ℝ) ^ 2 = ((q : ℝ) * D) ^ 2), ← mul_assoc,
    mul_comm ((v j : ℝ) ^ 2)]
  gcongr
  exact Finset.single_le_sum (f := fun i ↦ (freqWeight q D i : ℝ) * (v i : ℝ) ^ 2)
    (fun i _ ↦ by positivity) (Finset.mem_univ j)

/-- The dimensional factor of Minkowski's second theorem is absorbed by $4^{(k + 3)(k + 1)}$. -/
lemma two_pow_mul_factorial_le (k : ℕ) :
    2 ^ (k + 1) * (k + 1)! * (2 ^ k) ^ 2 ≤ (2 ^ ((k + 3) * (k + 1))) ^ 2 := by
  refine (Nat.mul_le_mul_right _ (Nat.mul_le_mul_left _ ((Nat.factorial_le_pow _).trans
    (Nat.pow_le_pow_left Nat.lt_two_pow_self.le _)))).trans ?_
  rw [← pow_mul, ← pow_mul, ← pow_mul, ← pow_add, ← pow_add]
  exact Nat.pow_le_pow_right two_pos (by nlinarith)

/-- Minkowski's bound for the frequency lattice, in terms of the dilations of its vectors. -/
lemma mul_prod_freqDilation_le {D : ℕ} (hq : 0 < q) (hD : 0 < D)
    {v : Fin (k + 1) → Fin (k + 1) → ℤ}
    (h : ∏ i, ∑ j, (freqWeight q D j : ℝ) * v i j ^ 2 ≤
      2 ^ (k + 1) * (k + 1)! * (((q : ℝ) ^ k) ^ 2 * ∏ j, (freqWeight (k := k) q D j : ℝ))) :
    q * (D + 1 : ℝ) ^ k * ∏ i, freqDilation q D (v i) ≤ 2 ^ ((k + 3) * (k + 1)) * (q : ℝ) ^ k := by
  have hD1 : (D + 1 : ℝ) ^ k ≤ 2 ^ k * D ^ k := by
    rw [← mul_pow]
    gcongr
    linarith [(Nat.one_le_cast (α := ℝ)).mpr hD]
  rw [(by exact_mod_cast prod_freqWeight q D : ∏ j, (freqWeight (k := k) q D j : ℝ) =
    D ^ 2 * (q ^ 2) ^ k)] at h
  simp only [freqDilation]
  refine (sq_le_sq₀ (by positivity) (by positivity)).mp ?_
  rw [Finset.prod_div_distrib, ← Real.sqrt_prod _ (fun i _ ↦ by positivity), Finset.prod_const,
    Finset.card_univ, Fintype.card_fin, ← mul_div_assoc, div_pow, mul_pow,
    Real.sq_sqrt (by positivity), div_le_iff₀ (by positivity)]
  calc ((q : ℝ) * (D + 1 : ℝ) ^ k) ^ 2 * ∏ i, ∑ j, (freqWeight q D j : ℝ) * v i j ^ 2
      ≤ ((q : ℝ) * (2 ^ k * D ^ k)) ^ 2 *
          (2 ^ (k + 1) * (k + 1)! * (((q : ℝ) ^ k) ^ 2 * (D ^ 2 * (q ^ 2) ^ k))) := by gcongr
    _ = 2 ^ (k + 1) * (k + 1)! * (2 ^ k) ^ 2 * ((q : ℝ) ^ (4 * k + 2) * (D : ℝ) ^ (2 * k + 2)) := by
        ring
    _ ≤ (2 ^ ((k + 3) * (k + 1))) ^ 2 * ((q : ℝ) ^ (4 * k + 2) * (D : ℝ) ^ (2 * k + 2)) := by
        gcongr
        exact_mod_cast two_pow_mul_factorial_le k
    _ = _ := by ring

/-- Minkowski's second theorem for the frequency lattice: there are $k + 1$ independent lattice
vectors $v_i$, each in the $t_i$-dilate of the box, with
$q (D + 1)^k \prod_i t_i \le 2^{(k + 3)(k + 1)} q^k$. -/
lemma exists_linearIndependent_isShort_freqLattice [NeZero q] (r : Fin k → ZMod q) {D : ℕ}
    (hD : 0 < D) :
    ∃ (v : Fin (k + 1) → Fin (k + 1) → ℤ) (t : Fin (k + 1) → ℝ), LinearIndependent ℤ v ∧
      (∀ i, v i ∈ freqLattice r) ∧ (∀ i, 0 < t i) ∧ (∀ i, IsShort (freqBox q D) (t i) (v i)) ∧
      q * (D + 1 : ℝ) ^ k * ∏ i, t i ≤ 2 ^ ((k + 3) * (k + 1)) * (q : ℝ) ^ k := by
  have hq := q.pos_of_neZero
  obtain ⟨v, hv, hmem, hprod⟩ := exists_linearIndependent_prod_weightedNorm_le
    (by simp [det_freqMatrix, NeZero.ne q] : (freqMatrix r).det ≠ 0) (freqWeight_pos hq hD)
  refine ⟨v, fun i ↦ freqDilation q D (v i), hv, ?_, fun i ↦ freqDilation_pos hq hD (hv.ne_zero i),
    fun i ↦ isShort_freqDilation hq hD (v i), mul_prod_freqDilation_le hq hD ?_⟩
  · intro i
    obtain ⟨c, hc⟩ := hmem i
    exact hc ▸ freqMatrix_mulVec_mem r c
  · rw [det_freqMatrix] at hprod
    exact_mod_cast hprod

end FrequencyLattice

/-! ## Combinations of short vectors -/

section ShortCombination

variable {d : ℕ}

/-- A combination $\sum_i n_i v_i$ of vectors $v_i$ in the $t_i$-dilates of a box lies in the
$c$-dilate of the box when $\sum_i |n_i| t_i \le c$. -/
lemma isShort_sum_zsmul {ι : Type*} [Fintype ι] {L : Fin d → ℕ} {t : ι → ℝ} {v : ι → Fin d → ℤ}
    (hv : ∀ i, IsShort L (t i) (v i)) {n : ι → ℤ} {c : ℝ} (hn : ∑ i, |(n i : ℝ)| * t i ≤ c) :
    IsShort L c (∑ i, n i • v i) := by
  intro j
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Int.cast_sum, Int.cast_mul]
  refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
  refine (Finset.sum_le_sum (g := fun i ↦ |(n i : ℝ)| * t i * L j) ?_).trans ?_
  · intro i _
    rw [abs_mul, mul_assoc]
    gcongr
    exact hv i j
  · rw [← Finset.sum_mul]
    gcongr

/-- The coefficient bounds $L_i = \lfloor 1 / (4 d t_i) \rfloor$ attached to dilations
$t_1, \dots, t_d$. -/
def coeffBound (t : Fin d → ℝ) (i : Fin d) : ℕ := ⌊1 / (4 * d * t i)⌋₊

/-- Coefficients with $|n_i| \le 2 L_i$ satisfy $\sum_i |n_i| t_i \le 1 / 2$. -/
lemma sum_abs_mul_le_half {t : Fin d → ℝ} (ht : ∀ i, 0 < t i) {n : Fin d → ℤ}
    (hn : ∀ i, |n i| ≤ 2 * coeffBound t i) : ∑ i, |(n i : ℝ)| * t i ≤ 1 / 2 := by
  refine (Finset.sum_le_sum (g := fun _ ↦ (1 / (2 * d) : ℝ)) ?_).trans ?_
  · intro i _
    have hti := ht i
    have hd : 0 < d := i.pos
    have hL : (coeffBound t i : ℝ) * (4 * d * t i) ≤ 1 :=
      (le_div_iff₀ (by positivity)).mp (Nat.floor_le (by positivity))
    rw [le_div_iff₀ (by positivity)]
    nlinarith [mul_le_mul_of_nonneg_right
      (by exact_mod_cast hn i : |(n i : ℝ)| ≤ 2 * coeffBound t i)
      (by positivity : (0 : ℝ) ≤ t i * (2 * d))]
  · rcases d.eq_zero_or_pos with rfl | hd
    · simp
    · simp [field]

/-- If $v_i$ lies in the $t_i$-dilate of a box of half-widths $L$ and $|n_i| \le 2 L_i$ for the
coefficient bounds of $t$, then $\sum_i n_i v_i$ lies in half the box. -/
lemma two_mul_abs_sum_zsmul_le {L : Fin d → ℕ} {t : Fin d → ℝ} {v : Fin d → Fin d → ℤ}
    (hv : ∀ i, IsShort L (t i) (v i)) (ht : ∀ i, 0 < t i) {n : Fin d → ℤ}
    (hn : ∀ i, |n i| ≤ 2 * coeffBound t i) (j : Fin d) : 2 * |(∑ i, n i • v i) j| ≤ L j := by
  exact_mod_cast (by linarith [isShort_sum_zsmul hv (sum_abs_mul_le_half ht hn) j] :
    2 * |(((∑ i, n i • v i) j : ℤ) : ℝ)| ≤ L j)

/-- A real number $z$ is at most $2 \lfloor z \rfloor + 1$, so the symmetric range
$[-\lfloor z \rfloor, \lfloor z \rfloor]$ has at least $z$ elements, also when $z < 1$. -/
lemma le_two_mul_floor_add_one (z : ℝ) : z ≤ 2 * ⌊z⌋₊ + 1 := by
  rcases le_or_gt z 1 with hle | hlt
  · linarith [Nat.cast_nonneg (α := ℝ) ⌊z⌋₊]
  · linarith [Nat.lt_floor_add_one z]

/-- The coefficient bounds $L_i$ of $t$ satisfy $1 \le \prod_i (2 L_i + 1) \cdot 4 d t_i$. -/
lemma one_le_prod_coeffBound_mul {t : Fin d → ℝ} (ht : ∀ i, 0 < t i) :
    1 ≤ ∏ i, (2 * coeffBound t i + 1 : ℝ) * (4 * d * t i) := by
  apply Finset.one_le_prod₀
  intro i _
  have hti := ht i
  have hd : 0 < d := i.pos
  rw [← div_le_iff₀ (by positivity)]
  exact le_two_mul_floor_add_one _

end ShortCombination

/-! ## Symmetric progressions

Progressions whose $i$-th coefficient ranges over $[-L_i, L_i]$. -/

section SymmetricGAP

/-- The progression with steps $x$ whose $i$-th coefficient ranges over $[-L_i, L_i]$. -/
def symmetricGAP {G : Type*} [DecidableEq G] [AddCommGroup G] {d : ℕ} (x : Fin d → G)
    (L : Fin d → ℕ) : GAP G :=
  GAP.ofData d (stepsHom x fun i ↦ -(L i : ℤ)) x (fun i ↦ 2 * L i + 1) fun _ ↦ Nat.succ_pos _

variable {G : Type*} [DecidableEq G] [AddCommGroup G] {d : ℕ} {x : Fin d → G} {L : Fin d → ℕ}

@[simp] lemma symmetricGAP_dim : (symmetricGAP x L).dim = d := rfl

@[simp] lemma symmetricGAP_length : (symmetricGAP x L).length = fun i ↦ 2 * L i + 1 := rfl

omit [DecidableEq G] in
/-- The point of the symmetric progression with coordinates $w$ is the combination of its steps
with coefficients $w_i - L_i$. -/
lemma gapMap_symmetricGAP (w : (i : Fin d) → Fin (2 * L i + 1)) :
    gapMap (stepsHom x fun i ↦ -(L i : ℤ)) x (fun i ↦ 2 * L i + 1) w =
      stepsHom x fun i ↦ (w i : ℤ) - L i := by
  rw [gapMap, stepsHom_apply, stepsHom_apply, ← Finset.sum_add_distrib]
  congr with i
  rw [sub_zsmul, natCast_zsmul, neg_zsmul]
  abel

/-- Every element of the symmetric progression is a combination of its steps with coefficients in
$[-L_i, L_i]$. -/
lemma exists_coeff_of_mem_symmetricGAP {y : G} (hy : y ∈ (symmetricGAP x L).carrier) :
    ∃ n : Fin d → ℤ, (∀ i, |n i| ≤ L i) ∧ y = stepsHom x n := by
  rw [(symmetricGAP x L).carrier_eq] at hy
  obtain ⟨w, -, rfl⟩ := Finset.mem_image.mp hy
  refine ⟨fun i ↦ (w i : ℤ) - L i, ?_, gapMap_symmetricGAP w⟩
  intro i
  rw [abs_le]
  grind [(by simpa using (w i).isLt : (w i : ℕ) < 2 * L i + 1)]

/-- The symmetric progression is proper as soon as its steps admit no nonzero relation with
coefficients in the doubled range. -/
lemma proper_symmetricGAP
    (h : ∀ n : Fin d → ℤ, (∀ i, |n i| ≤ 2 * L i) → stepsHom x n = 0 → ∀ i, n i = 0) :
    (symmetricGAP x L).Proper := by
  intro w w' hww'
  have hrel : stepsHom x
      ((fun i : Fin d ↦ (w i : ℤ) - L i) - fun i : Fin d ↦ (w' i : ℤ) - L i) = 0 := by
    rw [map_sub, sub_eq_zero]
    exact (gapMap_symmetricGAP w).symm.trans (hww'.trans (gapMap_symmetricGAP w'))
  have hbound (i : Fin d) :
      |((fun i : Fin d ↦ (w i : ℤ) - L i) - fun i : Fin d ↦ (w' i : ℤ) - L i) i| ≤ 2 * L i := by
    rw [Pi.sub_apply, abs_le]
    grind [(by simpa using (w i).isLt : (w i : ℕ) < 2 * L i + 1),
      (by simpa using (w' i).isLt : (w' i : ℕ) < 2 * L i + 1)]
  funext i
  exact Fin.ext (by grind [h _ hbound hrel i, Pi.sub_apply])

lemma card_symmetricGAP (h : (symmetricGAP x L).Proper) :
    (symmetricGAP x L).carrier.card = ∏ i, (2 * L i + 1) := by
  rw [GAP.card_eq_prod_length _ h]
  rfl

end SymmetricGAP

/-! ## The progression -/

section FrequencyGAP

variable {q k : ℕ} {r : Fin k → ZMod q} {D : ℕ} {v : Fin (k + 1) → Fin (k + 1) → ℤ}
  {t : Fin (k + 1) → ℝ}

/-- The symmetric progression in $\mathbb{Z}/q\mathbb{Z}$ whose steps are the first coordinates
of $v_0, \dots, v_k$ and whose coefficient bounds are `coeffBound t`. -/
def freqGAP (q : ℕ) (v : Fin (k + 1) → Fin (k + 1) → ℤ) (t : Fin (k + 1) → ℝ) :
    GAP (ZMod q) :=
  symmetricGAP (fun i ↦ ((v i 0 : ℤ) : ZMod q)) (coeffBound t)

lemma stepsHom_intCast_apply_zero (q : ℕ) (v : Fin (k + 1) → Fin (k + 1) → ℤ)
    (n : Fin (k + 1) → ℤ) :
    stepsHom (fun i ↦ ((v i 0 : ℤ) : ZMod q)) n = (((∑ i, n i • v i) 0 : ℤ) : ZMod q) := by
  simp [stepsHom_apply, Finset.sum_apply]

/-- A vector of the frequency lattice in half the frequency box whose first coordinate is
divisible by $q$ is zero when $D \le q$. -/
lemma eq_zero_of_mem_freqLattice [NeZero q] (hDq : D ≤ q) {y : Fin (k + 1) → ℤ}
    (hy : y ∈ freqLattice r) (hbox : ∀ j, 2 * |y j| ≤ freqBox q D j)
    (h0 : ((y 0 : ℤ) : ZMod q) = 0) : y = 0 := by
  have hq : (0 : ℤ) < q := by exact_mod_cast q.pos_of_neZero
  have hy0 : y 0 = 0 := Int.eq_zero_of_abs_lt_dvd ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp h0)
    (by grind [hbox 0, freqBox_zero])
  funext j
  induction j using Fin.cases with
  | zero => exact hy0
  | succ j =>
    refine Int.eq_zero_of_abs_lt_dvd (m := q) ?_ (by grind [hbox j.succ, freqBox_succ])
    rw [← ZMod.intCast_zmod_eq_zero_iff_dvd, mem_freqLattice.mp hy j, hy0]
    simp

/-- The progression `freqGAP q v t` is proper. -/
lemma proper_freqGAP [NeZero q] (hDq : D ≤ q) (hv : LinearIndependent ℤ v)
    (hmem : ∀ i, v i ∈ freqLattice r) (ht : ∀ i, 0 < t i)
    (hshort : ∀ i, IsShort (freqBox q D) (t i) (v i)) : (freqGAP q v t).Proper := by
  apply proper_symmetricGAP
  intro n hn hzero
  apply Fintype.linearIndependent_iff.mp hv n
  refine eq_zero_of_mem_freqLattice hDq
    (AddSubgroup.sum_mem _ fun i _ ↦ AddSubgroup.zsmul_mem _ (hmem i) _)
    (two_mul_abs_sum_zsmul_le hshort ht hn) ?_
  rwa [← stepsHom_intCast_apply_zero]

/-- Every element $y$ of `freqGAP q v t` satisfies $r_j y \equiv a_j \pmod q$ for integers
$|a_j| \le D$. -/
lemma exists_intCast_eq_mul_of_mem_freqGAP [NeZero q] (hmem : ∀ i, v i ∈ freqLattice r)
    (ht : ∀ i, 0 < t i) (hshort : ∀ i, IsShort (freqBox q D) (t i) (v i)) {y : ZMod q}
    (hy : y ∈ (freqGAP q v t).carrier) (j : Fin k) :
    ∃ a : ℤ, (a : ZMod q) = r j * y ∧ |a| ≤ D := by
  obtain ⟨n, hn, rfl⟩ := exists_coeff_of_mem_symmetricGAP hy
  refine ⟨(∑ i, n i • v i) j.succ, ?_, ?_⟩
  · rw [mem_freqLattice.mp (AddSubgroup.sum_mem _ fun i _ ↦ AddSubgroup.zsmul_mem _ (hmem i) _) j]
    exact congr_arg _ (stepsHom_intCast_apply_zero q v n).symm
  · grind [two_mul_abs_sum_zsmul_le hshort ht (fun i ↦ (hn i).trans (by grind)) j.succ,
      freqBox_succ]

end FrequencyGAP

/-- For frequencies $r_1, \dots, r_k$ of $\mathbb{Z}/q\mathbb{Z}$ and a width $0 < D \le q$,
there is a proper progression of dimension $k + 1$ all of whose elements $y$ satisfy
$r_j y \equiv a_j \pmod q$ for integers $|a_j| \le D$, and whose size is at least
$q ((D + 1) / q)^k$ up to the factor $(2^{k + 5} (k + 1))^{k + 1}$. -/
lemma exists_proper_gap_forall_exists_intCast_eq_mul {q k : ℕ} [NeZero q] (r : Fin k → ZMod q)
    {D : ℕ} (hD : 0 < D) (hDq : D ≤ q) :
    ∃ Q : GAP (ZMod q), Q.Proper ∧ Q.dim = k + 1 ∧
      (∀ y ∈ Q.carrier, ∀ j, ∃ a : ℤ, (a : ZMod q) = r j * y ∧ |a| ≤ D) ∧
      q * (D + 1 : ℝ) ^ k ≤ 2 ^ ((k + 5) * (k + 1)) * (k + 1 : ℝ) ^ (k + 1) * q ^ k *
        Q.carrier.card := by
  obtain ⟨v, t, hv, hmem, ht, hshort, hprod⟩ := exists_linearIndependent_isShort_freqLattice r hD
  have hQ := proper_freqGAP hDq hv hmem ht hshort
  refine ⟨freqGAP q v t, hQ, rfl,
    fun y hy j ↦ exists_intCast_eq_mul_of_mem_freqGAP hmem ht hshort hy j, ?_⟩
  rw [freqGAP, card_symmetricGAP hQ]
  push_cast
  calc (q : ℝ) * (D + 1 : ℝ) ^ k
      ≤ q * (D + 1 : ℝ) ^ k * ∏ i, (2 * coeffBound t i + 1 : ℝ) * (4 * (k + 1 : ℕ) * t i) :=
        le_mul_of_one_le_right (by positivity) (one_le_prod_coeffBound_mul ht)
    _ = q * (D + 1 : ℝ) ^ k * (∏ i, t i) *
          ((4 * (k + 1 : ℝ)) ^ (k + 1) * ∏ i, (2 * coeffBound t i + 1 : ℝ)) := by
        simp [Finset.prod_mul_distrib]
        ring
    _ ≤ 2 ^ ((k + 3) * (k + 1)) * (q : ℝ) ^ k *
          ((4 * (k + 1 : ℝ)) ^ (k + 1) * ∏ i, (2 * coeffBound t i + 1 : ℝ)) := by gcongr
    _ = _ := by
        rw [mul_pow, (by norm_num : (4 : ℝ) = 2 ^ 2), ← pow_mul]
        ring

/-- The Bohr set of chord width $\varepsilon$ of a finite set $\Delta$ of characters of
$\mathbb{Z}/q\mathbb{Z}$ contains a proper progression of dimension $|\Delta| + 1$ and density at
least $(\varepsilon / 2\pi)^{|\Delta|}$, up to the factor
$(2^{|\Delta| + 5} (|\Delta| + 1))^{|\Delta| + 1}$.

The hypothesis $2\pi \le \varepsilon q$ makes the Bohr set wider than one step of
$\mathbb{Z}/q\mathbb{Z}$. Without it the Bohr set can be $\{0\}$. -/
lemma exists_proper_gap_chordSet {q : ℕ} [NeZero q] (Δ : Finset (AddChar (ZMod q) ℂ)) {ε : ℝ}
    (hεq : 2 * Real.pi ≤ ε * q) (hε : ε ≤ 1) :
    ∃ Q : GAP (ZMod q), Q.Proper ∧ Q.dim = Δ.card + 1 ∧
      (Q.carrier : Set (ZMod q)) ⊆ {x | ∀ ψ ∈ Δ, ‖1 - ψ x‖ ≤ ε} ∧
      (q : ℝ) * (ε / (2 * Real.pi)) ^ Δ.card ≤
        (2 : ℝ) ^ ((Δ.card + 5) * (Δ.card + 1)) * ((Δ.card : ℝ) + 1) ^ (Δ.card + 1) *
          Q.carrier.card := by
  have hq : (0 : ℝ) < q := by exact_mod_cast q.pos_of_neZero
  have hε0 : 0 < ε := by nlinarith [Real.pi_pos]
  choose r hr using fun i : Fin Δ.card ↦
    exists_frequency_chord_le ((Δ.equivFin.symm i : Δ) : AddChar (ZMod q) ℂ)
  obtain ⟨Q, hproper, hdim, hchord, hsize⟩ := exists_proper_gap_forall_exists_intCast_eq_mul r
    (Nat.floor_pos.mpr ((one_le_div (by positivity)).mpr hεq))
    (Nat.floor_le_of_le (div_le_of_le_mul₀ (by positivity) hq.le (by nlinarith [Real.pi_gt_three])))
  refine ⟨Q, hproper, hdim, ?_, ?_⟩
  · intro y hy ψ hψ
    obtain ⟨a, ha, habs⟩ := hchord y hy (Δ.equivFin ⟨ψ, hψ⟩)
    refine (by simpa using hr _ y a ha : ‖1 - ψ y‖ ≤ 2 * Real.pi * |(a : ℝ)| / q).trans ?_
    rw [div_le_iff₀ hq, ← le_div_iff₀' (by positivity)]
    exact (by exact_mod_cast habs : |(a : ℝ)| ≤ ⌊ε * q / (2 * Real.pi)⌋₊).trans
      (Nat.floor_le (by positivity))
  · refine le_of_mul_le_mul_right ?_ (pow_pos hq Δ.card)
    calc (q : ℝ) * (ε / (2 * Real.pi)) ^ Δ.card * q ^ Δ.card
        = q * (ε * q / (2 * Real.pi)) ^ Δ.card := by ring
      _ ≤ q * (⌊ε * q / (2 * Real.pi)⌋₊ + 1 : ℝ) ^ Δ.card := by
          gcongr
          exact (Nat.lt_floor_add_one _).le
      _ ≤ 2 ^ ((Δ.card + 5) * (Δ.card + 1)) * (Δ.card + 1 : ℝ) ^ (Δ.card + 1) * q ^ Δ.card *
          Q.carrier.card := hsize
      _ = _ := by ring

end

end ChangFreimanRuzsa
