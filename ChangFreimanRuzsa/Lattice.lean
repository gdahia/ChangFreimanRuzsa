module

public import Mathlib.Algebra.Module.ZLattice.Basic
public import ChangFreimanRuzsa.IntVectorToReal
import Mathlib.LinearAlgebra.LinearIndependent.BaseChange

/-! # Lattices in coordinate subspaces

For a real subspace `H` of `ℝ ^ d`, this file defines the lattice `H ∩ ℤ ^ d` as
`subspaceIntegerLattice H`, a submodule of `H`. When `H` is spanned by a finite set `S` of integer
vectors, `integerGeneratedSubspace_isZLattice` shows that `H ∩ ℤ ^ d` is a full lattice in `H`,
so that its rank is the dimension of `H`. This is the lattice of Appendix A of Campos, Dahia and
Marciano, *On the independence number of sparser random Cayley graphs*. The file also shows that
every point of `ℤ ^ d ⊆ ℝ ^ d` is the image of an integer vector under `intVectorToReal`, and
defines `saturatedSpan S`, the subgroup of integer vectors in the real span of `S`.
-/

@[expose] public section

namespace ChangFreimanRuzsa

noncomputable section

/-- The standard integer lattice `ℤ ^ d` in `ℝ ^ d`. -/
def standardIntegerLattice (d : ℕ) : Submodule ℤ (Fin d → ℝ) :=
  Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin d)))

instance standardIntegerLattice_discrete (d : ℕ) :
    DiscreteTopology (standardIntegerLattice d) :=
  ZSpan.discreteTopology_pi_basisFun

lemma intVectorToReal_mem_standardIntegerLattice {d : ℕ} (v : Fin d → ℤ) :
    intVectorToReal v ∈ standardIntegerLattice d := by
  rw [standardIntegerLattice, (Pi.basisFun ℝ (Fin d)).mem_span_iff_repr_mem ℤ]
  intro i
  exact ⟨v i, by simp⟩

/-- The integer lattice `H ∩ ℤ ^ d` in a real subspace `H` of `ℝ ^ d`, represented as a submodule
of `H`. -/
def subspaceIntegerLattice {d : ℕ} (H : Submodule ℝ (Fin d → ℝ)) : Submodule ℤ H :=
  ZLattice.comap ℝ (standardIntegerLattice d) H.subtype

/-- The real subspace generated by a finite set of integer vectors. -/
def integerGeneratedSubspace {d : ℕ} (S : Finset (Fin d → ℤ)) :
    Submodule ℝ (Fin d → ℝ) :=
  Submodule.span ℝ (intVectorToReal '' (S : Set (Fin d → ℤ)))

/-- The real span of the image of a family `v` of integer vectors is the real span of the
family. -/
lemma integerGeneratedSubspace_image_univ {d r : ℕ} (v : Fin r → Fin d → ℤ) :
    integerGeneratedSubspace (Finset.univ.image v) =
      Submodule.span ℝ (Set.range fun j ↦ intVectorToReal (v j)) := by
  simp [integerGeneratedSubspace, ← Set.range_comp, Function.comp_def]

/-- A family of integer vectors is independent over `ℝ` if and only if it is independent over
`ℤ`. -/
@[simp] lemma linearIndependent_intVectorToReal_iff {ι : Type*} {d : ℕ}
    {v : ι → Fin d → ℤ} :
    LinearIndependent ℝ (fun i ↦ intVectorToReal (v i)) ↔ LinearIndependent ℤ v := by
  convert linearIndependent_algebraMap_comp_iff (S := ℝ) (v := v) using 3
  ext
  simp

/-- The saturation in `ℤ ^ d` of the subgroup generated by `S`: the integer vectors lying in the
real span of `S`. -/
def saturatedSpan {d : ℕ} (S : Finset (Fin d → ℤ)) : Submodule ℤ (Fin d → ℤ) :=
  ((integerGeneratedSubspace S).restrictScalars ℤ).comap intVectorToReal.toIntLinearMap

lemma mem_saturatedSpan {d : ℕ} {S : Finset (Fin d → ℤ)} {v : Fin d → ℤ} :
    v ∈ saturatedSpan S ↔ intVectorToReal v ∈ integerGeneratedSubspace S :=
  Iff.rfl

lemma subset_saturatedSpan {d : ℕ} (S : Finset (Fin d → ℤ)) :
    (S : Set (Fin d → ℤ)) ⊆ saturatedSpan S :=
  fun v hv ↦ Submodule.subset_span ⟨v, hv, rfl⟩

lemma span_range_le_saturatedSpan {d r : ℕ} (v : Fin r → Fin d → ℤ) :
    Submodule.span ℤ (Set.range v) ≤ saturatedSpan (Finset.univ.image v) := by
  rw [Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  apply subset_saturatedSpan
  simp

instance subspaceIntegerLattice_discrete {d : ℕ} (H : Submodule ℝ (Fin d → ℝ)) :
    DiscreteTopology (subspaceIntegerLattice H) :=
  ZLattice.comap_discreteTopology ℝ (standardIntegerLattice d)
    H.subtype.continuous_of_finiteDimensional H.subtype_injective

/-- The integer points of the real span `H` of a finite set `S` of integer vectors span `H`. -/
lemma span_subspaceIntegerLattice_integerGeneratedSubspace {d : ℕ} (S : Finset (Fin d → ℤ)) :
    Submodule.span ℝ
      (subspaceIntegerLattice (integerGeneratedSubspace S) :
        Set (integerGeneratedSubspace S)) = ⊤ := by
  apply Submodule.map_injective_of_injective (integerGeneratedSubspace S).subtype_injective
  rw [Submodule.map_top, Submodule.range_subtype, Submodule.map_span]
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨y, -, rfl⟩
    exact y.property
  · refine Submodule.span_le.2 ?_
    rintro _ ⟨v, hvS, rfl⟩
    apply Submodule.subset_span
    exact ⟨⟨intVectorToReal v, Submodule.subset_span ⟨v, hvS, rfl⟩⟩,
      intVectorToReal_mem_standardIntegerLattice v, rfl⟩

instance integerGeneratedSubspace_isZLattice {d : ℕ} (S : Finset (Fin d → ℤ)) :
    IsZLattice ℝ (subspaceIntegerLattice (integerGeneratedSubspace S)) :=
  ⟨span_subspaceIntegerLattice_integerGeneratedSubspace S⟩

lemma finrank_subspaceIntegerLattice_integerGeneratedSubspace {d : ℕ} (S : Finset (Fin d → ℤ)) :
    Module.finrank ℤ (subspaceIntegerLattice (integerGeneratedSubspace S)) =
      Module.finrank ℝ (integerGeneratedSubspace S) :=
  ZLattice.rank ℝ _

/-! ## Integral representatives of lattice points -/

lemma exists_intVectorToReal_of_mem_standardIntegerLattice {d : ℕ} {x : Fin d → ℝ}
    (hx : x ∈ standardIntegerLattice d) : ∃ v : Fin d → ℤ, intVectorToReal v = x := by
  rw [standardIntegerLattice, (Pi.basisFun ℝ (Fin d)).mem_span_iff_repr_mem ℤ] at hx
  choose v hv using hx
  refine ⟨v, ?_⟩
  ext i
  simpa using hv i

lemma mem_standardIntegerLattice_of_mem_subspaceIntegerLattice {d : ℕ}
    {H : Submodule ℝ (Fin d → ℝ)} {x : H} (hx : x ∈ subspaceIntegerLattice H) :
    (x : Fin d → ℝ) ∈ standardIntegerLattice d := hx

end

end ChangFreimanRuzsa
