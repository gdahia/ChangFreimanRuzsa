module

public import Mathlib.Algebra.Module.ZLattice.Basic
public import ChangFreimanRuzsa.ConvexProgression

/-! # Lattices in coordinate subspaces

This file sets up the lattice `H ∩ ℤ^d` used in Appendix A and shows that it spans `H` when `H` is
generated by integral vectors.
-/

@[expose] public section

namespace ChangFreimanRuzsa

noncomputable section

/-- The standard integer lattice in `ℝ^d`. -/
def standardIntegerLattice (d : ℕ) : Submodule ℤ (Fin d → ℝ) :=
  Submodule.span ℤ (Set.range (Pi.basisFun ℝ (Fin d)))

instance standardIntegerLattice_discrete (d : ℕ) :
    DiscreteTopology (standardIntegerLattice d) := by
  exact ZSpan.discreteTopology_pi_basisFun

lemma intVectorToReal_mem_standardIntegerLattice {d : ℕ} (v : Fin d → ℤ) :
    intVectorToReal v ∈ standardIntegerLattice d := by
  rw [standardIntegerLattice]
  suffices intVectorToReal v = ∑ i, v i • Pi.basisFun ℝ (Fin d) i by
    rw [this]
    apply Submodule.sum_mem
    intro i hi
    exact Submodule.smul_mem _ (v i)
      (Submodule.subset_span (Set.mem_range_self i))
  simpa [intVectorToReal, Int.cast_smul_eq_zsmul] using
    ((Pi.basisFun ℝ (Fin d)).sum_repr (intVectorToReal v)).symm

/-- The integer lattice in a real coordinate subspace `H`, represented as a submodule of `H`. -/
def subspaceIntegerLattice {d : ℕ} (H : Submodule ℝ (Fin d → ℝ)) : Submodule ℤ H :=
  ZLattice.comap ℝ (standardIntegerLattice d) H.subtype

/-- The real subspace generated by a finite set of integer vectors. -/
def integerGeneratedSubspace {d : ℕ} (S : Finset (Fin d → ℤ)) :
    Submodule ℝ (Fin d → ℝ) :=
  Submodule.span ℝ (intVectorToReal '' (S : Set (Fin d → ℤ)))

lemma subspaceIntegerLattice_discrete {d : ℕ} (H : Submodule ℝ (Fin d → ℝ)) :
    DiscreteTopology (subspaceIntegerLattice H) := by
  exact ZLattice.comap_discreteTopology ℝ (standardIntegerLattice d)
    H.subtype.continuous_of_finiteDimensional H.subtype_injective

lemma integerGeneratedSubspace_lattice_span_top {d : ℕ} (S : Finset (Fin d → ℤ)) :
    Submodule.span ℝ
      (subspaceIntegerLattice (integerGeneratedSubspace S) :
        Set (integerGeneratedSubspace S)) = ⊤ := by
  let H := integerGeneratedSubspace S
  let L := subspaceIntegerLattice H
  apply (Submodule.map_injective_of_injective H.subtype_injective)
  rw [Submodule.map_top, Submodule.range_subtype]
  rw [Submodule.map_span]
  apply le_antisymm
  · exact Submodule.span_le.mpr fun x hx ↦ by
      obtain ⟨y, hy, rfl⟩ := hx
      exact y.property
  · change Submodule.span ℝ (intVectorToReal '' (S : Set (Fin d → ℤ))) ≤ _
    apply Submodule.span_le.mpr
    intro x hx
    obtain ⟨v, hvS, rfl⟩ := hx
    have hvH : intVectorToReal v ∈ H := by
      apply Submodule.subset_span
      exact ⟨v, hvS, rfl⟩
    let y : H := ⟨intVectorToReal v, hvH⟩
    have hyL : y ∈ L := by
      exact intVectorToReal_mem_standardIntegerLattice v
    apply Submodule.subset_span
    exact ⟨y, hyL, rfl⟩

instance integerGeneratedSubspace_lattice_discrete {d : ℕ} (S : Finset (Fin d → ℤ)) :
    DiscreteTopology (subspaceIntegerLattice (integerGeneratedSubspace S)) :=
  subspaceIntegerLattice_discrete _

instance integerGeneratedSubspace_isZLattice {d : ℕ} (S : Finset (Fin d → ℤ)) :
    IsZLattice ℝ (subspaceIntegerLattice (integerGeneratedSubspace S)) :=
  ⟨integerGeneratedSubspace_lattice_span_top S⟩

lemma integerGeneratedSubspace_lattice_rank {d : ℕ} (S : Finset (Fin d → ℤ)) :
    Module.finrank ℤ (subspaceIntegerLattice (integerGeneratedSubspace S)) =
      Module.finrank ℝ (integerGeneratedSubspace S) := by
  exact ZLattice.rank ℝ _

/-! ## Integral representatives of lattice points -/

lemma exists_intVectorToReal_of_mem_standardIntegerLattice {d : ℕ} {x : Fin d → ℝ}
    (hx : x ∈ standardIntegerLattice d) : ∃ v : Fin d → ℤ, intVectorToReal v = x := by
  rw [standardIntegerLattice, (Pi.basisFun ℝ (Fin d)).mem_span_iff_repr_mem ℤ] at hx
  choose v hv using hx
  use v
  apply funext
  intro i
  simpa [intVectorToReal] using hv i

lemma mem_standardIntegerLattice_of_mem_subspaceIntegerLattice {d : ℕ}
    {H : Submodule ℝ (Fin d → ℝ)} {x : H} (hx : x ∈ subspaceIntegerLattice H) :
    (x : Fin d → ℝ) ∈ standardIntegerLattice d := hx

lemma intVectorToReal_zsmul {d : ℕ} (n : ℤ) (v : Fin d → ℤ) :
    intVectorToReal (n • v) = n • intVectorToReal v := by
  ext i
  simp [intVectorToReal, Pi.smul_apply, zsmul_eq_mul]

lemma intVectorToReal_sum {ι : Type*} {d : ℕ} (s : Finset ι) (f : ι → Fin d → ℤ) :
    intVectorToReal (∑ i ∈ s, f i) = ∑ i ∈ s, intVectorToReal (f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, intVectorToReal_add, ih]

end

end ChangFreimanRuzsa
